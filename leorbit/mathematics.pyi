    def cast(self, dim: type[SomeOtherDim]) -> Tensor[SomeOtherDim]: ...
    def copy(self) -> Tensor[SomeDim]: ...
    def ensure_compatible_dimensions(self, o: Tensor[Any]) -> bool: ...
    def check(self, dim: type[Dim]) -> bool: ...
    def get_raw_array(self, units: str = "1") -> npt.NDArray[np.float64]: ...

    def __pos__(self) -> Tensor[SomeDim]: ...
    def __neg__(self) -> Tensor[SomeDim]: ...

    def __add__(self, o: object) -> Tensor[Any]: ...
    def __radd__(self, o: object) -> Tensor[Any]: ...
    def __sub__(self, o: object) -> Tensor[Any]: ...
    def __rsub__(self, o: object) -> Tensor[Any]: ...
    def __mul__(self, o: object) -> Tensor[Any]: ...
    def __rmul__(self, o: object) -> Tensor[Any]: ...
    def __truediv__(self, o: object) -> Tensor[Any]: ...
    def __rtruediv__(self, o: object) -> Tensor[Any]: ...
    def __matmul__(self, o: object) -> Tensor[Any]: ...
    def __rmatmul__(self, o: object) -> Tensor[Any]: ...
    def __mod__(self, o: object) -> Tensor[Any]: ...
    def __rmod__(self, o: object) -> Tensor[Any]: ...


