class QuantityMeta(type):
    def __getattr__(cls, name: str) -> Scalar[Any]: ...


class Quantity(metaclass=QuantityMeta):
    @classmethod
    def get(cls, value: str) -> Scalar[Any]: ...

    # DIMENSIONLESS
    dimensionless: Scalar[Dimless]

    # ANGLES
    radian: Scalar[Angle]
    turn: Scalar[Angle]
    degree: Scalar[Angle]

    # DISTANCES
    meter: Scalar[Length]
    kilo_meter: Scalar[Length]
    radii_earth: Scalar[Length]
    radii_sun: Scalar[Length]
    astronomical_unit: Scalar[Length]

    # DURATIONS
    second: Scalar[Time]
    minute: Scalar[Time]
    hour: Scalar[Time]
    day: Scalar[Time]
    month: Scalar[Time]
    year: Scalar[Time]

    # MASSES
    kilo_gram: Scalar[Mass]
    gram: Scalar[Mass]
    metric_ton: Scalar[Mass]
